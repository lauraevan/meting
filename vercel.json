{
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/demo/public/index.html"
    },
    {
      "source": "/app.js",
      "destination": "/demo/public/app.js"
    },
    {
      "source": "/styles.css",
      "destination": "/demo/public/styles.css"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
